gets_values_named":{"clip_name":"qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors","type":"minimax","device":"default"}},{"id":130,"type":"CreateVideo","pos":[330,5650],"size":[270,150],"flags":{},"order":25,"mode":0,"inputs":[{"localized_name":"图像","name":"images","type":"IMAGE","link":258},{"localized_name":"音频","name":"audio","shape":7,"type":"AUDIO","link":259},{"localized_name":"帧率","name":"fps","type":"FLOAT","widget":{"name":"fps"},"link":null},{"localized_name":"bit_depth","name":"bit_depth","shape":7,"type":"COMBO","widget":{"name":"bit_depth"},"link":null},{"localized_name":"color_space","name":"color_space","shape":7,"type":"COMBO","widget":{"name":"color_space"},"link":null},{"localized_name":"codec","name":"codec","shape":7,"type":"COMBO","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"视频","name":"VIDEO","type":"VIDEO","links":[260]}],"properties":{"Node name for S&R":"CreateVideo","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[24,8,"sRGB","none"],"widgets_values_named":{"fps":24,"bit_depth":8,"color_space":"sRGB","codec":"none"}},{"id":131,"type":"ComfyMathExpression","pos":[-1467.0095432422797,6433.280098038399],"size":[225,74],"flags":{"collapsed":true},"order":16,"mode":0,"inputs":[{"label":"a","localized_name":"a","name":"values.a","type":"FLOAT,INT,BOOLEAN","link":261},{"localized_name":"b","name":"values.b","shape":7,"type":"FLOAT,INT,BOOLEAN","link":null},{"localized_name":"表达式","name":"expression","type":"STRING","widget":{"name":"expression"},"link":null}],"outputs":[{"localized_name":"浮点","name":"FLOAT","type":"FLOAT","links":[]},{"localized_name":"整数","name":"INT","type":"INT","links":[275,361]},{"localized_name":"布尔值","name":"BOOL","type":"BOOLEAN","links":[]}],"properties":{"Node name for S&R":"ComfyMathExpression","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":["max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"],"widgets_values_named":{"expression":"max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"}},{"id":132,"type":"PrimitiveFloat","pos":[-1467.0095432422797,6293.280098038399],"size":[270,70],"flags":{},"order":5,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"FLOAT","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"浮点","name":"FLOAT","type":"FLOAT","links":[261]}],"title":"Float (Duration)","properties":{"Node name for S&R":"PrimitiveFloat","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":[5],"widgets_values_named":{"value":5},"color":"#322","bgcolor":"#533"},{"id":136,"type":"MiniMaxH3ReferenceToVideo","pos":[-620,5420],"size":[400,380],"flags":{},"order":26,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":272},{"localized_name":"vae","name":"vae","shape":7,"type":"VAE","link":273},{"localized_name":"audio_vae","name":"audio_vae","shape":7,"type":"VAE","link":274},{"label":"ref_image_0","localized_name":"ref_image_0","name":"ref_images.ref_image_0","shape":7,"type":"IMAGE","link":278},{"localized_name":"ref_image_1","name":"ref_images.ref_image_1","shape":7,"type":"IMAGE","link":null},{"label":"ref_video_0","localized_name":"ref_video_0","name":"ref_videos.ref_video_0","shape":7,"type":"IMAGE","link":346},{"localized_name":"ref_video_1","name":"ref_videos.ref_video_1","shape":7,"type":"IMAGE","link":null},{"label":"ref_video_audio_0","localized_name":"ref_video_audio_0","name":"ref_video_audios.ref_video_audio_0","shape":7,"type":"AUDIO","link":null},{"label":"ref_audio_0","localized_name":"ref_audio_0","name":"ref_audios.ref_audio_0","shape":7,"type":"AUDIO","link":null},{"localized_name":"提示词","name":"prompt","type":"STRING","widget":{"name":"prompt"},"link":279},{"localized_name":"宽度","name":"width","type":"INT","widget":{"name":"width"},"link":276},{"localized_name":"高度","name":"height","type":"INT","widget":{"name":"height"},"link":277},{"localized_name":"长度","name":"length","type":"INT","widget":{"name":"length"},"link":275},{"localized_name":"参考图像尺寸","name":"ref_image_size","type":"COMBO","widget":{"name":"ref_image_size"},"link":null},{"label":"ref_image_2","name":"ref_images.ref_image_2","shape":7,"type":"IMAGE","link":null}],"outputs":[{"localized_name":"正向","name":"positive","type":"CONDITIONING","links":[270]},{"localized_name":"Latent","name":"LATENT","type":"LATENT","links":[271]}],"properties":{"Node name for S&R":"MiniMaxH3ReferenceToVideo","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":["",1344,768,124,"max"],"widgets_values_named":{"prompt":"","width":1344,"height":768,"length":124,"ref_image_size":"max"}},{"id":137,"type":"LoadImage","pos":[-1027.00954324228,5953.280098038399],"size":[290,330],"flags":{},"order":6,"mode":0,"inputs":[{"localized_name":"图像","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"选择文件上传","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"图像","name":"IMAGE","type":"IMAGE","links":[278]},{"localized_name":"遮罩","name":"MASK","type":"MASK","links":null}],"properties":{"Node name for S&R":"LoadImage","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":["pose_boxing_first.png","image"],"widgets_values_named":{"image":"pose_boxing_first.png","upload":"image"}},{"id":138,"type":"PrimitiveStringMultiline","pos":[-1467.0095432422797,6513.280098038399],"size":[370,390],"flags":{},"order":7,"mode":0,"inputs":[{"localized_name":"值","name":"value","type":"STRING","widget":{"name":"value"},"link":null}],"outputs":[{"localized_name":"字符串","name":"STRING","type":"STRING","links":[279]}],"title":"Input Text (Prompt)","properties":{"Node name for S&R":"PrimitiveStringMultiline","cnr_id":"comfy-core","ver":"0.33.0"},"widgets_values":["subject_definitions:\n<Picture 1> An adult male boxer in a black T-shirt and pale boxing gloves stands in a gym with a painted wall.\n<Video 1> The frame-aligned body pose sequence for the same shot.\n\nsummary:\n[reference generation] Reconstruct the person in <Picture 1> while following the body motion and timing of <Video 1>.\n\nretention_analysis:\n<Picture 1>: fully_preserved - identity, clothing, objects, background and lighting.\n<Video 1>: attribute_transfer - body joint positions and motion timing only, without displaying skeleton lines.\n\ndetailed_description:\nA natural live-action shot. [Shot 1] An adult male boxer in a black T-shirt and pale boxing gloves stands in a gym with a painted wall. He holds his guard, performs alternating straight practice punches, and returns each glove to his guard, following the source rather than adding a new combination. Match the visible joint positions and camera framing in the control at every time, retaining the reference person's proportions and stable object geometry. Keep the same subject present throughout the five-second clip.\n\noverall_soundscape:\nNatural quiet sounds appropriate to the scene, without speech.\n\nnon_diegetic_music:\nN/A"],"widgets_values_named":{"value":"subject_definitions:\n<Picture 1> An adult male boxer in a black T-shirt and pale boxing gloves stands in a gym with a painted wall.\n<Video 1> The frame-aligned body pose sequence for the same shot.\n\nsummary:\n[reference generation] Reconstruct the person in <Picture 1> while following the body motion and timing of <Video 1>.\n\nretention_analysis:\n<Picture 1>: fully_preserved - identity, clothing, objects, background and lighting.\n<Video 1>: attribute_transfer - body joint positions and motion timing only, without displaying skeleton lines.\n\ndetailed_description:\nA natural live-action shot. [Shot 1] An adult male boxer in a black T-shirt and pale boxing gloves stands in a gym with a painted wall. He holds his guard, performs alternating straight practice punches, and returns each glove to his guard, following the source rather than adding a new combination. Match the visible joint positions and camera framing in the control at every time, retaining the reference person's proportions and stable object geometry. Keep the same subject present throughout the five-second clip.\n\noverall_soundscape:\nNatural quiet sounds appropriate to the scene, without speech.\n\nnon_diegetic_music:\nN/A"},"color":"#322","bgcolor":"#533"},{"id":140,"type":"MarkdownNote","pos":[-1880,6070],"size":[300,520],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"Note: Size Settings Reference","properties":{},"widgets_values":["| megapixels | Aspect | Output (multiple=32) |\n|---|---|---|\n| 0.2 | 16:9 | 608 x 352 |\n| 0.3 | 16:9 | 736 x 416 |\n| 0.4 | 16:9 | 864 x 480 |\n| 0.5 | 16:9 | 960 x 544 |\n| 0.6 | 16:9 | 1056 x 608 |\n| 0.7 | 16:9 | 1152 x 640 |\n| 0.8 | 16:9 | 1216 x 672 |\n| 0.9 | 16:9 | 1280 x 736 |\n| 0.98 | 16:9 | 1344 x 768 (official 768p) |"],"widgets_values_named":{"text":"| megapixels | Aspect | Output (multiple=32) |\n|---|---|---|\n| 0.2 | 16:9 | 608 x 352 |\n| 0.3 | 16:9 | 736 x 416 |\n| 0.4 | 16:9 | 864 x 480 |\n| 0.5 | 16:9 | 960 x 544 |\n| 0.6 | 16:9 | 1056 x 608 |\n| 0.7 | 16:9 | 1152 x 640 |\n| 0.8 | 16:9 | 1216 x 672 |\n| 0.9 | 16:9 | 1280 x 736 |\n| 0.98 | 16:9 | 1344 x 768 (official 768p) |"},"color":"#222","bgcolor":"#000"},{"id":200,"type":"MarkdownNote","pos":[-2500,5700],"size":[440,961],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[],"title":"Note: LynnReal Standard 4-step DMD","properties":{},"widgets_values":["## LynnReal Standard · 4-step DMD (pose control (pose/boxing))\n\nFollows `test/demo/cases/…` for this task: an appearance image plus a\nframe-aligned control clip.\n\n- `LoadImage` → `ref_images.ref_image_0` (identity, clothing, scene)\n- `LoadVideo` → `LynnRealAlignedReference` → `ref_videos.ref_video_0`\n  (identity/motion control, on the target canvas and frame grid)\n- `UNETLoader`: `lynnreal_omni_standard_bf16.safetensors`, `simple`, 4 steps, `euler`\n\n`LynnRealAlignedReference` is a port of the release's\n  `model/reference.py::AlignedReferenceSetup`, the block every\n`test/demo/cases/{pose,hand}` case installs through `aligned_indices`:\n\n1. `resample_reference_frames` → the model's 24 fps grid, dropping and repeating\n   whole frames exactly as the reference decode did;\n2. truncate to the generation's frame count;\n3. rescale onto the **target** canvas, holding the last frame to reach the count.\n\nStep 3 is what the previous chain missed — `VideoFrameSample` + a plain frame\nsample is not the reference resampler, and the clip used to reach the model on\nthe canvas its own aspect ratio resolved to. Any control fps works, no manual\ntranscode. Pass the same width / height / length as the reference node.\n\nSwap the two inputs and the prompt to run a different pose or hand case.\n\n**Precision — INT8 (optional)**\n\nThe **`Use INT8 model?`** switch above the loader (default **off**) swaps `UNETLoader` from\n`lynnreal_omni_standard_bf16.safetensors` to `lynnreal_omni_standard_int8.safetensors`. Same\nW8A8 contract as the release's `--precision int8` path: per-output-channel weight scales,\nper-token activation scales, INT32 accumulate; block 0, the last block, the token refiner,\nadaLN and the IO projections stay BF16.\n\n- warm runs are ~8 s faster (41.4 GiB resident instead of 61.7 GiB, so the DiT, the text\n  encoder and both VAEs fit at once), and the file is 44.5 GB on disk instead of 66.3 GB;\n- it is **not the same sample**: quantization shifts the sampling trajectory, so a fixed seed\n  gives a different composition (measured against bf16 at the same seed: 14.8 dB PSNR). Both\n  are the same style and quality; keep the switch off when you want seed-to-seed comparison;\n- the unselected branch is lazy, so leaving the switch off costs nothing.\n"],"widgets_values_named":{"text":"## LynnReal Standard · 4-step DMD (pose control (pose/boxing))\n\nFollows `test/demo/cases/…` for this task: an appearance image plus a\nframe-aligned control clip.\n\n- `LoadImage` → `ref_images.ref_image_0` (identity, clothing, scene)\n- `LoadVideo` → `LynnRealAlignedReference` → `ref_videos.ref_video_0`\n  (identity/motion control, on the target canvas and frame grid)\n- `UNETLoader`: `lynnreal_omni_standard_bf16.safetensors`, `simple`, 4 steps, `euler`\n\n`LynnRealAlignedReference` is a port of the release's\n  `model/reference.py::AlignedReferenceSetup`, the block every\n`test/demo/cases/{pose,hand}` case installs through `aligned_indices`:\n\n1. `resample_reference_frames` → the model's 24 fps grid, dropping and repeating\n   whole frames exactly as the reference decode did;\n2. truncate to the generation's frame count;\n3. rescale onto the **target** canvas, holding the last frame to reach the count.\n\nStep 3 is what the previous chain missed — `VideoFrameSample` + a plain frame\nsample is not the reference resampler, and the clip used to reach the model on\nthe canvas its own aspect ratio resolved to. Any control fps works, no manual\ntranscode. Pass the same width / height / length as the reference node.\n\nSwap the two inputs and the prompt to run a different pose or hand case.\n\n**Precision — INT8 (optional)**\n\nThe **`Use INT8 model?`** switch above the loader (default **off**) swaps `UNETLoader` from\n`lynnreal_omni_standard_bf16.safetensors` to `lynnreal_omni_standard_int8.safetensors`. Same\nW8A8 contract as the release's `--precision int8` path: per-output-channel weight scales,\nper-token activation scales, INT32 accumulate; block 0, the last block, the token refiner,\nadaLN and the IO projections stay BF16.\n\n- warm runs are ~8 s faster (41.4 GiB resident instead of 61.7 GiB, so the DiT, the text\n  encoder and both VAEs fit at once), and the file is 44.5 GB on disk instead of 66.3 GB;\n- it is **not the same sample**: quantization shifts the sampling trajectory, so a fixed seed\n  gives a different composition (measured against bf16 at the same seed: 14.8 dB PSNR). Both\n  are the same style and quality; keep the switch off when you want seed-to-seed comparison;\n- the unselected branch is lazy, so leaving the switch off costs nothing.\n"},"color":"#432","bgcolor":"#653"},{"id":203,"type":"ComfySwitchNode","pos":[-790,5040],"size":[240,80],"flags":{},"order":17,"mode":0,"inputs":[{"localized_name":"为假时","name":"on_false","shape":7,"type":"MODEL","link":362},{"localized_name":"为真时","name":"on_true","shape":7,"type":"MODEL","link":363},{"localized_name":"切换","name":"switch","type":"BOOLEAN","widget":{"name":"switch"},"link":364}],"outputs":[{"localized_name":"输出","name":"output","type":"MODEL","links":[252,292]}],"title":"Model: bf16 (off) / INT8 (on)","properties":{"Node name for S&R":"ComfySwitchNode"},"widgets_values":[false],"widgets_values_named":{"switch":false}},{"id":127,"type":"UNETLoader","pos":[-1486.1247647237883,5132.589541909314],"size":[640,90],"flags":{},"order":10,"mode":0,"inputs":[{"localized_name":"UNet名称","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"localized_name":"数据类型","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[362]}],"properties":{"Node name for S&R":"UNETLoader","cnr_id":"comfy-core","ver":"0.33.0","models":[{"name":"lynnreal_omni_standard_bf16.safetensors","directory":"diffusion_models"}]},"widgets_values":["lynnreal_omni_standard_bf16.safetensors","default"],"widgets_values_named":{"unet_name":"lynnreal_omni_standard_bf16.safetensors","weight_dtype":"default"}},{"id":201,"type":"UNETLoader","pos":[-1483.282925521234,4965.990097633986],"size":[640,90],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"UNet名称","name":"unet_name","type":"COMBO","widget":{"name":"unet_name"},"link":null},{"localized_name":"数据类型","name":"weight_dtype","type":"COMBO","widget":{"name":"weight_dtype"},"link":null}],"outputs":[{"localized_name":"模型","name":"MODEL","type":"MODEL","links":[363]}],"title":"UNETLoader (INT8, optional)","properties":{"Node name for S&R":"UNETLoader","cnr_id":"comfy-core","ver":"0.33.0","models":[{"name":"ly